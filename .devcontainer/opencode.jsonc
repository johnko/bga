{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": [
    "cloudflare-ai-gateway",
    "lmstudio"
  ],
  "plugin": [
    "@spoons-and-mirrors/subtask2@latest",
    "opencode-pty",
    "opencode-scheduler"
  ],
  "provider": {
    "lmstudio": {
      "models": {
        "google/gemma-3-4b": {
          "reasoning": true,
          "tool_call": true
        },
        "google/gemma-4-12b-it-qat": {
          "reasoning": true,
          "tool_call": true
        },
        "google/gemma-4-12b-qat": {
          "reasoning": true,
          "tool_call": true
        },
        "openai/gpt-oss-20b": {
          "reasoning": true,
          "tool_call": true
        },
        "qwen/qwen3.5-9b": {
          "reasoning": true,
          "tool_call": true
        },
        "qwen/qwen3.6-27b": {
          "reasoning": true,
          "tool_call": true
        }
      },
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://10.88.111.202:1234/v1"
      }
    }
  },
  "share": "disabled"
}
